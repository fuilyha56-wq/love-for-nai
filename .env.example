NEWAPI_BASE_URL=http://host.docker.internal:3000
# AFF 直连 Gateway 支付：配置后 AFF 足够的生成会绕过 NewAPI，直接调用 Gateway
# （由平台 NovelAI 凭据承担上游成本），AFF 不足时自动改用登录用户的 NewAPI 余额。
# LFN_AFF_GATEWAY_URL 是 Gateway 的 /v1 入口地址，LFN_AFF_GATEWAY_TOKEN 是
# Gateway 的 GATEWAY_PASSWORD（Bearer）。两者必须同时配置才会启用 AFF 支付。
LFN_AFF_GATEWAY_URL=
LFN_AFF_GATEWAY_TOKEN=
QUOTA_PER_UNIT=500000
LFN_SESSION_SECRET=replace-with-at-least-32-random-bytes
LFN_COOKIE_SECURE=false
LFN_PORT=21142
LFN_PUBLIC_URL=http://localhost:21142
SOURCE_CODE_URL=https://github.com/fuilyha56-wq/love-for-nai
# Danbooru/Wikipedia 无法直连时填写 HTTP(S) 代理地址。
LFN_OUTBOUND_PROXY=
# 仅当入口反向代理会覆盖 X-Forwarded-For 时开启。
LFN_TRUST_PROXY=false
# NewAPI root/system token，仅用于注册后将新用户划入 Draw 分组；不要提交真实 token。
LFN_ADMIN_TOKEN=
LFN_ADMIN_USER_ID=1
LFN_REGISTER_GROUP=Draw
